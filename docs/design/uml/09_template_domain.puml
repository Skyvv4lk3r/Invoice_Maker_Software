@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

skinparam ranksep 85

top to bottom direction
class TemplateFamily <<aggregate root>> {
  +id: UUID
  +name: str
  +documentKind: SalesInvoice
}
class TemplateDraft <<mutable candidate>> {
  +id: UUID
  +baseVersionId: UUID [0..1]
  +contentHash: str
  +state: Editing | Validated | Published
  +updateAppearance(changes)
}
class TemplateVersion <<immutable release>> {
  +id: UUID
  +version: int
  +bundleHash: str
  +modelSchemaVersion: int
  +publishedAt: Instant
  +retired: bool
}
class TemplateBundle <<immutable>> {
  +pdfLayoutAssetId: UUID
  +docxTemplateAssetId: UUID
  +requiredFields: tuple of FieldKey
  +supportedFormats: PDF and DOCX
}
class AppearanceConfig <<value object>> {
  +pageSize: A4
  +margins: Margins
  +fontKey: ApprovedFont
  +accentColor: Color
  +optionalSections: SectionSelection
}
class AssetRef <<immutable>> {
  +id: UUID
  +sha256: str
  +mimeType: str
  +storageKey: str
}
class TemplateValidationReport <<immutable>> {
  +candidateHash: str
  +schemaChecksPassed: bool
  +pdfSampleArtifactId: UUID
  +docxSampleArtifactId: UUID
  +visualReviewRecorded: bool
}
class DefaultTemplateSelection {
  +firmId: UUID
  +documentKind: str
  +templateVersionId: UUID
}
TemplateFamily "1" *-- "0..*" TemplateDraft
TemplateFamily "1" *-- "0..*" TemplateVersion
TemplateDraft "1" *-- "1" AppearanceConfig
TemplateVersion "1" *-- "1" TemplateBundle
TemplateBundle "0..*" --> "2..*" AssetRef : layouts and fonts
TemplateDraft "1" -- "0..*" TemplateValidationReport
DefaultTemplateSelection "0..*" --> "1" TemplateVersion
@enduml
