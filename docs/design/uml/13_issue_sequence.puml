@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

autonumber
participant "Qt frontend" as UI
participant "IInvoiceIssueCommands\nInvoiceIssueService + handler" as UC
participant "Domain policies / calculator" as Rules
participant "Unit of work + repositories" as UOW
database "SQLite" as DB
UI -> UC : issue(id, expectedRevision, requestId)
UC -> UOW : Create scope; beginImmediate()
UOW -> DB : BEGIN IMMEDIATE
UC -> UOW : Find request receipt; reload draft and\ncontext
alt Request already committed
  UOW --> UC : Original success result
  UC -> UOW : End transaction
  UC --> UI : Same invoice number and job ID
else New valid request
  UC -> Rules : Validate state, period, fields and tax\ntreatment
  Rules --> UC : Validated financial facts or error
  UC -> UOW : Resolve published default template and\nfrozen branding
  alt Validation error / stale version / template unavailable / recovery lock
    UC -> UOW : rollback()
    UC --> UI : Typed ApplicationErrorDTO
  else Preconditions satisfied
    UC -> UOW : Allocate number in invoice-date financial\nyear
    UC -> UOW : Save issued snapshot and immutable\nRenderBinding
    UC -> UOW : Save invoice, counter, audit, PDF job and\nrequest receipt
    UC -> UOW : commit()
    UOW -> DB : COMMIT
    UC --> UI : IssueResult(number, snapshotId, pdfJobId)
  end
end
@enduml
