@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

top to bottom direction
interface ITemplateCommands {
  +saveDraft(request): TemplateDraftDTO
  +validate(request): ValidationReportDTO
  +publish(request): TemplateVersionDTO
  +activate(request): CommandResult
  +retire(request): CommandResult
}
interface ITemplateQueries {
  +list(): tuple of TemplateSummaryDTO
  +getVersion(id): TemplateVersionDTO
}
interface IDocumentCommands {
  +preview(request): JobAcceptedDTO
  +generateIssued(request): JobAcceptedDTO
}
interface IExportCommands {
  +prepare(filter): ExportPreviewDTO
  +generate(manifestId): JobAcceptedDTO
}
interface IJobQueries {
  +status(jobId): JobStatusDTO
}
interface IJobCommands {
  +cancel(jobId): CommandResult
  +retry(jobId): JobAcceptedDTO
}
interface IShareCommands {
  +reveal(artifactIds): HandoffResultDTO
}
class PreviewRequest <<immutable DTO>> {
  +draftId: UUID
  +expectedRevision: int
  +templateCandidateId: UUID
  +candidateHash: str
  +format: PDF | DOCX
}
class JobStatusDTO <<immutable DTO>> {
  +id: UUID
  +state: JobState
  +completed: int
  +total: int
  +artifactIds: tuple of UUID
  +error: ApplicationErrorDTO [0..1]
}
IDocumentCommands ..> PreviewRequest
IDocumentCommands ..> JobStatusDTO : via returned jobId
IExportCommands ..> JobStatusDTO : via returned jobId
IJobQueries ..> JobStatusDTO
ITemplateCommands -[hidden]down-> ITemplateQueries
IJobQueries -[hidden]down-> IJobCommands
IJobCommands -[hidden]down-> IShareCommands
@enduml
