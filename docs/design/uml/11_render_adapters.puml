@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

top to bottom direction
class RenderDocumentHandler <<application>> {
  +handle(job): ArtifactDTO
}
interface ITemplateReader {
  +readBundle(versionId): TemplateBundleDTO
}
interface IAssetReader {
  +readVerified(assetId): AssetBytes
}
interface IInvoiceRenderer {
  +format: DocumentFormat
  +render(model, bundle, assets): RenderedDocument
}
class ReportLabInvoiceRenderer <<infrastructure>>
class DocxtplInvoiceRenderer <<infrastructure>>
interface IArtifactReader {
  +findVerified(key): ArtifactRef [0..1]
}
interface IArtifactWriter {
  +publishAtomic(key, bytes): ArtifactRef
}
class RendererRegistry <<application>> {
  +get(format, version): IInvoiceRenderer
}
class RenderedDocument <<immutable DTO>> {
  +bytes: bytes
  +mimeType: str
  +extension: str
}
RenderDocumentHandler --> RendererRegistry
RenderDocumentHandler --> ITemplateReader
RenderDocumentHandler --> IAssetReader
RenderDocumentHandler --> IArtifactWriter
RenderDocumentHandler --> IArtifactReader
RendererRegistry --> IInvoiceRenderer
ReportLabInvoiceRenderer ..|> IInvoiceRenderer
DocxtplInvoiceRenderer ..|> IInvoiceRenderer
IInvoiceRenderer ..> RenderedDocument
IAssetReader -[hidden]down-> IArtifactWriter
IArtifactReader -[hidden]down-> IArtifactWriter
@enduml
