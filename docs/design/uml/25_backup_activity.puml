@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

start
:Scheduled while app is running\nor owner selects Back up now;
:Acquire maintenance gate;\npause new writes and drain active workers;
:Create SQLite snapshot through backup API;\ncopy referenced immutable assets and documents;
:Write manifest with schema version,\nfile hashes and sequence high-water marks;
:Release maintenance gate;\nresume normal invoicing;
:Verify staged snapshot and files;
if (Snapshot complete and valid?) then (yes)
  :Encrypt archive with authenticated encryption;\nuse protected key + recovery mechanism;
  :Write local backup atomically;
  :Copy completed archive to configured\ncloud-synced folder or external drive;
  if (Second-copy write succeeded?) then (yes)
    :Record local backup and second-copy status;\ncloud folder copy is not remote upload proof;
  else (no)
    :Keep local backup; show second-copy failure\nand offer retry;
  endif
else (no)
  :Keep previous good backups;\nrecord failure and show recovery action;
endif
stop
@enduml
