@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

top to bottom direction
class export_run <<table>> {
  +id: UUID [PK]
  +filter_json: TEXT
  +captured_at: UTC_INSTANT
  +summary_json: TEXT
  +state: TEXT
}
class export_member <<table>> {
  +export_run_id: UUID [FK]
  +ordinal: INTEGER
  +document_kind: TEXT
  +snapshot_id: UUID
  +binding_id: UUID
  +captured_status: TEXT
  +register_values_json: TEXT
}
class job <<table>> {
  +id: UUID [PK]
  +kind: TEXT
  +idempotency_key: TEXT [UNIQUE]
  +state: TEXT
  +lease_until: UTC_INSTANT?
  +attempts: INTEGER
  +payload_ref: UUID
}
class audit_event <<append-only table>> {
  +id: UUID [PK]
  +aggregate_id: UUID
  +action: TEXT
  +actor_id: TEXT
  +at: UTC_INSTANT
  +change_json: TEXT
}
class payment_entry <<table>> {
  +id: UUID [PK]
  +invoice_id: UUID [FK]
  +amount_paise: INTEGER
  +kind: Receipt | Reversal
  +reverses_id: UUID? [FK]
}
class adjustment_allocation <<table>> {
  +adjustment_id: UUID [FK]
  +invoice_id: UUID [FK]
  +allocated_paise: INTEGER
}
export_run "1" *-- "0..*" export_member
export_run "1" -- "0..*" job : export attempts
export_run ..> audit_event : preparation / handoff history
payment_entry ..> audit_event : append receipt or reversal
adjustment_allocation ..> audit_event : approved adjustment action
@enduml
