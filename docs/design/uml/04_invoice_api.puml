@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

top to bottom direction
interface IInvoiceDraftCommands {
  +save(SaveDraftRequest): DraftResult
  +duplicate(DuplicateRequest): DraftResult
  +delete(DeleteDraftRequest): CommandResult
}
interface IInvoiceIssueCommands {
  +issue(IssueInvoiceRequest): IssueResult
  +correct(CorrectionRequest): IssueResult
  +cancel(CancelRequest): CommandResult
}
interface IInvoiceQueries {
  +get(id): InvoiceDetailsDTO
  +list(filter, cursor): InvoicePageDTO
  +calculateDraft(input): CalculationDTO
}
class IssueInvoiceRequest <<immutable DTO>> {
  +invoiceId: UUID
  +expectedRevision: int
  +requestId: UUID
}
class IssueResult <<immutable DTO>> {
  +invoiceId: UUID
  +invoiceNumber: int
  +invoiceDate: ISODate
  +snapshotId: UUID
  +pdfJobId: UUID
}
class InvoiceDetailsDTO <<immutable DTO>> {
  +id: UUID
  +number: int [0..1]
  +status: str
  +lines: tuple of LineDTO
  +totals: TotalsDTO
  +revision: int
}
class ApplicationErrorDTO <<immutable DTO>> {
  +code: ErrorCode
  +fieldErrors: tuple of FieldError
  +correlationId: UUID
  +retryable: bool
}
class InvoiceIssueService <<application facade>> {
  +issue(request): IssueResult
  +correct(request): IssueResult
  +cancel(request): CommandResult
}
InvoiceIssueService ..|> IInvoiceIssueCommands
IInvoiceIssueCommands ..> IssueInvoiceRequest
IInvoiceIssueCommands ..> IssueResult
IInvoiceQueries ..> InvoiceDetailsDTO
IInvoiceDraftCommands ..> ApplicationErrorDTO
IInvoiceIssueCommands ..> ApplicationErrorDTO
IInvoiceQueries ..> ApplicationErrorDTO
@enduml
