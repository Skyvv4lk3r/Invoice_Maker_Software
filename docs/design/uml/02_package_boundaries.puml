@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

top to bottom direction
package "presentation.qt\nViews, view models, QtTaskBridge\nUI themes and widget state" as UI
package "application.contracts\nInbound Protocols + immutable DTOs\nError codes and job status" as API
package "application.handlers\nUse-case implementations\nMapping, authorization, orchestration" as APP
package "application.ports\nOutbound Protocols\nPersistence, documents, OS, backup" as PORTS
package "domain\nInvoice, Money, FiscalYear\nCalculation and lifecycle policies" as DOMAIN
package "infrastructure\nSQLAlchemy / SQLite / Alembic\nReportLab / docxtpl / files / crypto" as INFRA
package "bootstrap\nComposition root\nConstruct and inject implementations" as ROOT
UI ..> API : imports only public backend API
APP ..> API : implements inbound contracts
APP ..> DOMAIN : invokes business rules
APP ..> PORTS : depends on outbound contracts
INFRA ..> PORTS : implements adapters
INFRA ..> DOMAIN : maps persistence values
ROOT ..> UI : wires view models
ROOT ..> APP : wires handlers
ROOT ..> INFRA : selects concrete adapters
ROOT ..> API : exposes typed capabilities
@enduml
