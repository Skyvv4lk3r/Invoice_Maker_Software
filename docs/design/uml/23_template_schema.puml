@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #456478
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam classBackgroundColor #F5F9FB
skinparam classBorderColor #35556B
skinparam interfaceBackgroundColor #EAF7F4
skinparam interfaceBorderColor #147D73
skinparam componentBackgroundColor #F1F7FB
skinparam componentBorderColor #35556B
skinparam packageBackgroundColor #FCFDFE
skinparam packageBorderColor #B9CAD4
skinparam stateBackgroundColor #EDF7F5
skinparam stateBorderColor #147D73
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #D1B46A
skinparam actorBorderColor #35556B
skinparam usecaseBackgroundColor #F2F8FC
skinparam usecaseBorderColor #35556B
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #EAF3F8
skinparam sequenceParticipantBorderColor #35556B
skinparam sequenceLifeLineBorderColor #839BAA
skinparam sequenceGroupBackgroundColor #F5F9FB
skinparam activityBackgroundColor #EFF7FA
skinparam activityBorderColor #35556B
skinparam activityDiamondBackgroundColor #EAF7F4
skinparam activityDiamondBorderColor #147D73
hide empty members

skinparam ranksep 85

top to bottom direction
class template_family <<table>> {
  +id: UUID [PK]
  +name: TEXT
}
class template_draft <<table>> {
  +id: UUID [PK]
  +family_id: UUID [FK]
  +candidate_hash: TEXT
  +candidate_json: TEXT
  +row_version: INTEGER
}
class template_version <<table>> {
  +id: UUID [PK]
  +family_id: UUID [FK]
  +version: INTEGER
  +bundle_hash: TEXT
  +bundle_json: TEXT
  +retired: BOOLEAN
}
class branding_snapshot <<table>> {
  +id: UUID [PK]
  +appearance_json: TEXT
  +content_hash: TEXT
}
class render_binding <<table>> {
  +id: UUID [PK]
  +invoice_snapshot_id: UUID [FK]
  +template_version_id: UUID [FK]
  +branding_snapshot_id: UUID [FK]
  +renderer_set_version: TEXT
}
class asset <<table>> {
  +id: UUID [PK]
  +sha256: TEXT
  +storage_key: TEXT
  +mime_type: TEXT
}
class artifact <<table>> {
  +id: UUID [PK]
  +binding_id: UUID [FK]
  +format: TEXT
  +renderer_version: TEXT
  +sha256: TEXT
  +storage_key: TEXT
}
template_family "1" -- "0..*" template_draft
template_family "1" -- "0..*" template_version
template_version "1" -- "0..*" render_binding
branding_snapshot "1" -- "0..*" render_binding
template_version "0..*" -- "2..*" asset
branding_snapshot "0..*" -- "0..*" asset
render_binding "1" -- "0..*" artifact
@enduml
